}

enum LabExamType {
  BILAN_SANGUIN
  GLYCEMIE
  BILAN_LIPIDIQUE
  BILAN_HEPATIQUE
  BILAN_RENAL
  BILAN_THYROIDIEN
  EXAMEN_URINE
  EXAMEN_SELLES
  TEST_PALUDISME
  TEST_VIH
  TEST_GROSSESSE
  BILAN_COMPLET
  AUTRE
}

enum NursingCareType {
  PRISE_TENSION
  INJECTION
  PANSEMENT
  PERFUSION
  PRISE_DE_SANG
  SUIVI_POST_OPERATOIRE
  ADMINISTRATION_MED
  SOINS_PLAIE
  AUTRE_SOIN
}

enum NursingCareStatus {
  PENDING
  ASSIGNED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ElderlyCareType {
  SUIVI_MEDICAL
  AIDE_MOBILITE
  GESTION_MEDICAMENTS
  SOINS_HYGIENE
  COMPAGNIE_MEDICALISEE
  REEDUCATION
  BILAN_SANTE
  AUTRE_ELDERLY
}

enum ElderlyCareFrequency {
  PONCTUEL
  QUOTIDIEN
  HEBDOMADAIRE
  MENSUEL
}

enum ElderlyCareStatus {
  PENDING
  ASSIGNED
  ACTIVE
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────────
// MODEL : Examen de laboratoire
// ─────────────────────────────────────────────────
model LabExam {
  id              String        @id @default(cuid())
  patientId       String
  agentId         String?
  requestedById   String
  examTypes       LabExamType[]
  status          LabExamStatus @default(PENDING)
  address         String
  city            String
  scheduledAt     DateTime
  collectedAt     DateTime?
  resultsAt       DateTime?
  instructions    String?
  agentNotes      String?
  samplePhotoUrl  String?
  resultFileUrl   String?
  resultNotes     String?
  prescriptionRef String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  patient     User     @relation("PatientLabExams",   fields: [patientId],     references: [id])
  agent       User?    @relation("AgentLabExams",     fields: [agentId],       references: [id])
  requestedBy User     @relation("RequestedLabExams", fields: [requestedById], references: [id])
  payment     Payment?

  @@index([patientId])
  @@index([agentId])
  @@index([status])
}

// ─────────────────────────────────────────────────
// MODEL : Soin infirmier
// ─────────────────────────────────────────────────
model NursingCare {
  id              String            @id @default(cuid())
  patientId       String
  agentId         String?
  careTypes       NursingCareType[]
  status          NursingCareStatus @default(PENDING)
  address         String
  city            String
  scheduledAt     DateTime
  completedAt     DateTime?
  duration        Int?
  instructions    String?
  materials       String?
  agentNotes      String?
  reportUrl       String?
  photoUrl        String?
  prescriptionRef String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  patient User  @relation("PatientNursingCares", fields: [patientId], references: [id])
  agent   User? @relation("AgentNursingCares",   fields: [agentId],   references: [id])
  payment Payment?

  @@index([patientId])
  @@index([agentId])
  @@index([status])
}

// ─────────────────────────────────────────────────
// MODEL : Soin personnes âgées
// ─────────────────────────────────────────────────
model ElderlyCare {
  id            String               @id @default(cuid())
  patientId     String
  agentId       String?
  careTypes     ElderlyCareType[]
  frequency     ElderlyCareFrequency @default(PONCTUEL)
  status        ElderlyCareStatus    @default(PENDING)
  address       String
  city          String
  scheduledAt   DateTime
  endDate       DateTime?
  completedAt   DateTime?
  duration      Int                  @default(60)
  patientAge    Int?
  medicalNotes  String?
  mobilityLevel String?
  agentNotes    String?
  reportUrl     String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  patient User  @relation("PatientElderlyCares", fields: [patientId], references: [id])
  agent   User? @relation("AgentElderlyCares",   fields: [agentId],   references: [id])
  payment Payment?

  @@index([patientId])
  @@index([agentId])
  @@index([status])
}

// ─────────────────────────────────────────────────
// MODEL : Chat Support patient ↔ Call Center
// ─────────────────────────────────────────────────
model SupportChat {
  id            String   @id @default(cuid())
  patientId     String
  callCenterId  String?
  subject       String
  isOpen        Boolean  @default(true)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient    User  @relation("PatientChats",    fields: [patientId],    references: [id])
  callCenter User? @relation("CallCenterChats", fields: [callCenterId], references: [id])
  messages   SupportMessage[]

  @@index([patientId])
  @@index([callCenterId])
  @@index([isOpen])
}

model SupportMessage {
  id        String   @id @default(cuid())
  chatId    String
  senderId  String
  content   String
  isRead    Boolean  @default(false)
  fileUrl   String?
  createdAt DateTime @default(now())

  chat   SupportChat @relation(fields: [chatId],   references: [id], onDelete: Cascade)
  sender User        @relation("SupportMessageSender", fields: [senderId], references: [id])

  @@index([chatId])
  @@index([senderId])
  @@index([isRead])
}

// ─────────────────────────────────────────────────
// MODULE PHARMACIE — ENUMS
// ─────────────────────────────────────────────────

enum MedicamentCategorie {
  ANTIBIOTIQUE
  ANALGESIQUE
  ANTIPALUDEEN
  ANTIHYPERTENSEUR
  ANTIDIABETIQUE
  ANTIINFLAMMATOIRE
  ANTIPARASITAIRE
  VITAMINES
  CONTRACEPTIF
  DERMATOLOGIE
  OPHTALMOLOGIE
  GASTROENTEROLOGIE
  CARDIOVASCULAIRE
  NEUROLOGIE
  PEDIATRIE
  AUTRE_MEDICAMENT
}

enum CommandePharmacieStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrdonnancePharmacieStatus {
  UPLOADED
  PROCESSING
  FOUND
  PARTIALLY_FOUND
  NOT_FOUND
  ORDERED
}

enum TypeLivraison {
  CLICK_AND_COLLECT
  LIVRAISON_DOMICILE
}

// ─────────────────────────────────────────────────
// MODULE PHARMACIE — MODÈLES
// ─────────────────────────────────────────────────

model PharmacieProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  nomPharmacie     String
  numeroLicence    String   @unique
  adresse          String
  quartier         String
  ville            String   @default("Brazzaville")
  telephone        String
  email            String?
  logoUrl          String?
  photoUrl         String?
  description      String?
  horaires         Json
  latitude         Float?
  longitude        Float?
  isVerified       Boolean  @default(false)
  isActive         Boolean  @default(true)
  accepteLivraison Boolean  @default(false)
  zoneLivraison    String?
  notesMoyenne     Float?   @default(0)
  nombreAvis       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user        User               @relation("PharmacieUser", fields: [userId], references: [id], onDelete: Cascade)
  medicaments MedicamentStock[]
  commandes   CommandePharmacie[]
  avis        AvisPharmacie[]

  @@index([ville])
  @@index([isVerified])
  @@index([isActive])
}

model MedicamentStock {
  id                String              @id @default(cuid())
  pharmacieId       String
  nomMedicament     String
  nomGenerique      String?
  marque            String?
  categorie         MedicamentCategorie
  description       String?
  formeGalenique    String
  dosage            String?
  conditionnement   String?
  prixUnitaire      Float
  quantiteStock     Int                 @default(0)
  stockMinimum      Int                 @default(5)
  photoUrl          String?
  ordonnanceRequise Boolean             @default(false)
  estDisponible     Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  pharmacie      PharmacieProfile         @relation(fields: [pharmacieId], references: [id], onDelete: Cascade)
  lignesCommande LigneCommandePharmacie[]

  @@index([pharmacieId])
  @@index([nomMedicament])
  @@index([categorie])
  @@index([estDisponible])
  @@index([nomMedicament, pharmacieId])
}

model OrdonnancePharmacieRequest {
  id                 String                    @id @default(cuid())
  patientId          String
  callCenterId       String?
  ordonnanceUrl      String
  ordonnanceType     String
  prescriptionId     String?
  status             OrdonnancePharmacieStatus @default(UPLOADED)
  notesCallCenter    String?
  medicamentsTrouves Json?
  commandeId         String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  patient    User  @relation("PatientOrdonnances",    fields: [patientId],    references: [id])
  callCenter User? @relation("CallCenterOrdonnances", fields: [callCenterId], references: [id])

  @@index([patientId])
  @@index([status])
}

model CommandePharmacie {
  id               String                  @id @default(cuid())
  patientId        String
  pharmacieId      String
  agentId          String?
  typeLivraison    TypeLivraison
  status           CommandePharmacieStatus @default(PENDING)
  adresseLivraison String?
  villeLivraison   String?
  instructions     String?
  montantTotal     Float
  montantLivraison Float                   @default(0)
  ordonnanceUrl    String?
  confirmedAt      DateTime?
  preparedAt       DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  agentNotes       String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  patient   User              @relation("PatientCommandes", fields: [patientId],   references: [id])
  pharmacie PharmacieProfile  @relation(fields: [pharmacieId], references: [id])
  agent     User?             @relation("AgentCommandes",   fields: [agentId],     references: [id])
  lignes    LigneCommandePharmacie[]
  payment   Payment?

  @@index([patientId])
  @@index([pharmacieId])
  @@index([agentId])
  @@index([status])
}

model LigneCommandePharmacie {
  id           String   @id @default(cuid())
  commandeId   String
  medicamentId String
  quantite     Int
  prixUnitaire Float
  sousTotal    Float
  createdAt    DateTime @default(now())

  commande   CommandePharmacie @relation(fields: [commandeId],   references: [id], onDelete: Cascade)
  medicament MedicamentStock   @relation(fields: [medicamentId], references: [id])

  @@index([commandeId])
  @@index([medicamentId])
}

model AvisPharmacie {
  id          String   @id @default(cuid())
  patientId   String
  pharmacieId String
  note        Int
  commentaire String?
  commandeId  String?
  createdAt   DateTime @default(now())

  patient   User             @relation("PatientAvis", fields: [patientId],   references: [id])
  pharmacie PharmacieProfile @relation(fields: [pharmacieId], references: [id])

  @@unique([patientId, pharmacieId, commandeId])
  @@index([pharmacieId])
}

// ─────────────────────────────────────────────────
// MODULE PARRAINAGE
// ─────────────────────────────────────────────────

model ReferralPointTransaction {
  id             String   @id @default(cuid())
  beneficiaryId  String   // Parrain qui reçoit les points
  triggeredById  String   // Patient dont la 1ère connexion a déclenché les points
  level          Int      // 1 = parrain direct, 2 = parrain du parrain, etc.
  pointsAwarded  Float    // 1, 0.5, 0.25, 0.125 ...
  createdAt      DateTime @default(now())

  beneficiary User @relation("PointsBeneficiary", fields: [beneficiaryId], references: [id])
  triggeredBy User @relation("PointsTriggeredBy", fields: [triggeredById],  references: [id])

  @@index([beneficiaryId])
  @@index([triggeredById])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────
// MODEL : Disponibilité ponctuelle (Call Center / présentiel)
// ─────────────────────────────────────────────────
model DoctorAvailability {
  id        String @id @default(cuid())
  doctorId  String
  dayOfWeek Int    // 0=Dimanche … 6=Samedi (JS Date.getDay())
  startTime String // "08:00"
  endTime   String // "12:00"

  doctor User @relation("DoctorAvailabilities", fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek, startTime])
  @@index([doctorId])
}

// ─────────────────────────────────────────────────
// MODEL : Planning hebdomadaire récurrent médecin
// (consultation instantanée + nouveau parcours patient)
// ─────────────────────────────────────────────────
model DoctorWeeklySchedule {
  id        String                @id @default(cuid())
  doctorId  String
  jour      JourSemaine
  type      TypeConsultationDispo
  startTime String                // "14:00"
  endTime   String                // "19:00"
  isActive  Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  doctor User @relation("DoctorWeeklySchedule", fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, jour, type])
  @@index([doctorId])
  @@index([jour])
}
