generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url gérée via prisma.config.ts (Prisma 7 — pas de url ici)
}

// ─────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────

enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

enum TypeConsultationDispo {
  VIDEO
  PRESENTIEL
}

enum Role {
  SUPER_ADMIN
  CALL_CENTER_AGENT
  MEDECIN
  AGENT_TERRAIN
  PATIENT
  PHARMACIE
}

enum AppointmentStatus {
  PENDING            // En attente validation Call Center
  AWAITING_APPROVAL  // Soumis à l'Admin, en attente
  APPROVED           // Approuvé par l'Admin
  REJECTED           // Refusé
  PAYMENT_PENDING    // En attente de paiement
  CONFIRMED          // Payé et confirmé
  IN_PROGRESS        // Consultation en cours
  COMPLETED          // Consultation terminée
  CANCELLED          // Annulé
  NO_SHOW            // Patient absent
}

enum PresentielStatus {
  EN_ATTENTE
  NOUVEAU_CRENEAU
  CRENEAU_ACCEPTE
  CONFIRME
  EN_COURS
  TERMINE
  ANNULE
  ABSENT
}

enum PresentielUrgence {
  EVENTUEL
  OBLIGATOIRE
  URGENT
}

enum ExamenPrescritStatut {
  EN_ATTENTE
  EFFECTUE
  RESULTATS_RECUS
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum HomeVisitType {
  CARE      // Soin à domicile
  SAMPLING  // Prélèvement à domicile
}

enum HomeVisitStatus {
  PENDING   // En attente d'assignation
  ASSIGNED  // Agent assigné
  EN_ROUTE  // Agent en route
  ARRIVED   // Agent arrivé
  COMPLETED // Mission terminée
  CANCELLED // Mission annulée
}

enum MedicalSpeciality {
  GENERALISTE
  CARDIOLOGUE
  DERMATOLOGUE
  PEDIATRE
  GYNECOLOGUE
  OPHTALMOLOGUE
  PSYCHIATRE
  NEUROLOGUE
  ORTHOPEDIE
  AUTRE
}

// ─────────────────────────────────────────────────
// MODEL : Compte utilisateur (tous rôles confondus)
// ─────────────────────────────────────────────────
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String    @unique
  passwordHash String
  role         Role
  isActive     Boolean   @default(true)
  isVerified   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
  otpCode      String?
  otpExpiry    DateTime?

  // Profils (un seul actif selon le rôle)
  patientProfile PatientProfile?
  doctorProfile  DoctorProfile?
  agentProfile   AgentProfile?

  // Rendez-vous selon le rôle
  appointmentsAsPatient    Appointment[] @relation("PatientAppointments")
  appointmentsAsDoctor     Appointment[] @relation("DoctorAppointments")
  appointmentsAsCallCenter Appointment[] @relation("CallCenterAppointments")

  cabinet              CabinetMedecin?          @relation("DoctorCabinet")
  rdvPresentielPatient RendezVousPresentiel[]   @relation("PatientRdvPresentiel")
  rdvPresentielDoctor  RendezVousPresentiel[]   @relation("DoctorRdvPresentiel")
  rdvPresentielCC      RendezVousPresentiel[]   @relation("CallCenterRdvPresentiel")

  // Visites à domicile selon le rôle
  homeVisitsAsPatient HomeVisit[] @relation("PatientHomeVisits")
  homeVisitsAsAgent   HomeVisit[] @relation("AgentHomeVisits")

  // Messagerie interne
  sentMessages     ChatMessage[] @relation("SentMessages")
  receivedMessages ChatMessage[] @relation("ReceivedMessages")

  // Autres
  notifications Notification[]
  auditLogs     AuditLog[]
  payments      Payment[]

  // Examens de laboratoire
  labExamsAsPatient  LabExam[] @relation("PatientLabExams")
  labExamsAsAgent    LabExam[] @relation("AgentLabExams")
  requestedLabExams  LabExam[] @relation("RequestedLabExams")

  // Soins infirmiers
  nursingCaresAsPatient NursingCare[] @relation("PatientNursingCares")
  nursingCaresAsAgent   NursingCare[] @relation("AgentNursingCares")

  // Soins personnes âgées
  elderlyCaresAsPatient ElderlyCare[] @relation("PatientElderlyCares")
  elderlyCaresAsAgent   ElderlyCare[] @relation("AgentElderlyCares")

  // Chat support patient ↔ Call Center
  patientChats    SupportChat[]    @relation("PatientChats")
  callCenterChats SupportChat[]    @relation("CallCenterChats")
  supportMessages SupportMessage[] @relation("SupportMessageSender")

  // Pharmacie
  pharmacieProfile      PharmacieProfile?            @relation("PharmacieUser")
  commandesAsPatient    CommandePharmacie[]           @relation("PatientCommandes")
  commandesAsAgent      CommandePharmacie[]           @relation("AgentCommandes")
  ordonnancesPatient    OrdonnancePharmacieRequest[]  @relation("PatientOrdonnances")
  ordonnancesCallCenter OrdonnancePharmacieRequest[]  @relation("CallCenterOrdonnances")
  avisPharmacies        AvisPharmacie[]               @relation("PatientAvis")

  // Parrainage
  referralCode    String?   @unique
  referredById    String?
  referredAt      DateTime?
  firstLoginAt    DateTime?

  referrer        User?     @relation("ReferralChain", fields: [referredById], references: [id])
  referrals       User[]    @relation("ReferralChain")
  pointsReceived  ReferralPointTransaction[] @relation("PointsBeneficiary")
  pointsTriggered ReferralPointTransaction[] @relation("PointsTriggeredBy")

  // Examens prescrits
  examensAsPatient ExamenPrescrit[] @relation("ExamenPatient")
  examensAsDoctor  ExamenPrescrit[] @relation("ExamenDoctor")
  presentielTraite Consultation[]   @relation("PresentielTraitePar")

  // Planning hebdomadaire médecin
  doctorAvailabilities DoctorAvailability[]   @relation("DoctorAvailabilities")
  weeklySchedule       DoctorWeeklySchedule[] @relation("DoctorWeeklySchedule")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([referralCode])
  @@index([referredById])
}

// ─────────────────────────────────────────────────
// MODEL : Profil Patient
// ─────────────────────────────────────────────────
model PatientProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  firstName        String
  lastName         String
  dateOfBirth      DateTime
  gender           String
  bloodType        String?
  address          String
  city             String
  medicalHistory   String?  // Antécédents médicaux
  allergies        String?  // Allergies connues
  emergencyContact String?  // Nom + téléphone contact urgence
  avatarUrl        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────
// MODEL : Profil Médecin
// ─────────────────────────────────────────────────
model DoctorProfile {
  id                String            @id @default(cuid())
  userId            String            @unique
  firstName         String
  lastName          String
  speciality        MedicalSpeciality
  licenseNumber     String            @unique
  isVerifiedByAdmin Boolean           @default(false)
  consultationFee   Float
  bio               String?
  avatarUrl         String?
  availabilities    Json?             // Créneaux JSON
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────
// MODEL : Cabinet Médical
// ─────────────────────────────────────────────────
model CabinetMedecin {
  id        String   @id @default(cuid())
  doctorId  String   @unique
  name      String
  address   String
  city      String
  phone     String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  doctor     User                   @relation("DoctorCabinet", fields: [doctorId], references: [id])
  presentiels RendezVousPresentiel[]

  @@index([doctorId])
}

// ─────────────────────────────────────────────────
// MODEL : Présentiel
// ─────────────────────────────────────────────────
model RendezVousPresentiel {
  id           String          @id @default(cuid())
  patientId    String
  doctorId     String
  callCenterId String?
  cabinetId    String
  scheduledAt  DateTime
  duration     Int             @default(30)
  status       PresentielStatus @default(EN_ATTENTE)
  reason       String
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now())

  patient    User           @relation("PatientRdvPresentiel", fields: [patientId], references: [id])
  doctor     User           @relation("DoctorRdvPresentiel", fields: [doctorId], references: [id])
  callCenter User?          @relation("CallCenterRdvPresentiel", fields: [callCenterId], references: [id])
  cabinet    CabinetMedecin @relation(fields: [cabinetId], references: [id])
  payment    Payment?

  @@index([patientId])
  @@index([doctorId])
  @@index([cabinetId])
  @@index([status])
}

// ─────────────────────────────────────────────────
// MODEL : Profil Agent Terrain
// ─────────────────────────────────────────────────
model AgentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String
  lastName  String
  zone      String   // Zone géographique couverte
  phone     String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────
// MODEL : Rendez-vous
// ─────────────────────────────────────────────────
model Appointment {
  id              String            @id @default(cuid())
  patientId       String
  doctorId        String
  callCenterId    String?
  scheduledAt     DateTime
  duration        Int               @default(30) // minutes
  status          AppointmentStatus @default(PENDING)
  // RÈGLE DB-1 : adminApprovedAt IS NOT NULL = autorisé par l'Admin
  // NULL signifie que le médecin ne peut PAS accéder au dossier patient
  adminApprovedAt DateTime?
  adminApprovedBy String?           // ID de l'admin qui a approuvé
  adminNote       String?           // Note de refus ou d'approbation
  isInstant       Boolean           @default(false) // Demande instantanée — priorité absolue pour l'admin
  videoRoomUrl    String?           // URL salle Daily.co
  videoRoomName   String?           // Nom salle Daily.co
  reason          String            // Motif de consultation
  notes           String?           // Notes internes Call Center
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  patient      User          @relation("PatientAppointments", fields: [patientId], references: [id])
  doctor       User          @relation("DoctorAppointments", fields: [doctorId], references: [id])
  callCenter   User?         @relation("CallCenterAppointments", fields: [callCenterId], references: [id])
  payment      Payment?
  consultation Consultation?

  @@index([patientId])
  @@index([doctorId])
  @@index([scheduledAt])
  @@index([status])
}

// ─────────────────────────────────────────────────
// MODEL : Consultation (créée après le RDV terminé)
// ─────────────────────────────────────────────────
model Consultation {
  id              String    @id @default(cuid())
  appointmentId   String    @unique
  clinicalNotes   String?
  diagnosis       String?
  prescriptionUrl String?
  followUpDate    DateTime?
  duration        Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // ── Dossier enrichi ──────────────────────────────
  signesSubjectifs     String?           // Plaintes rapportées par le patient
  hypothesesDiagnostic String?           // Pistes diagnostiques du médecin
  prescriptionTexte    String?           // Prescription texte libre

  // Alerte présentiel
  presentielRecommande  PresentielUrgence?
  presentielMotif        String?
  presentielNotifieAt    DateTime?
  presentielTraiteParId  String?
  presentielTraiteAt     DateTime?

  // Ordonnance photo
  ordonnancePhotoUrl  String?
  ordonnanceEnvoyeeAt DateTime?

  appointment       Appointment   @relation(fields: [appointmentId], references: [id])
  examens           ExamenPrescrit[]
  presentielTraitePar User?       @relation("PresentielTraitePar", fields: [presentielTraiteParId], references: [id])
}

// ─────────────────────────────────────────────────
// MODEL : Examen prescrit (visibilité restreinte)
// ─────────────────────────────────────────────────
model ExamenPrescrit {
  id             String               @id @default(cuid())
  consultationId String
  patientId      String
  doctorId       String
  typeExamen     String
  instructions   String?
  statut         ExamenPrescritStatut @default(EN_ATTENTE)
  resultatNote   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  consultation Consultation @relation(fields: [consultationId], references: [id])
  patient      User         @relation("ExamenPatient", fields: [patientId], references: [id])
  doctor       User         @relation("ExamenDoctor",  fields: [doctorId],  references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@index([consultationId])
}

// ─────────────────────────────────────────────────
// MODEL : Visite à domicile
// ─────────────────────────────────────────────────
model HomeVisit {
  id          String          @id @default(cuid())
  patientId   String
  agentId     String?         // Assigné par l'Admin
  type        HomeVisitType
  status      HomeVisitStatus @default(PENDING)
  address     String
  city        String
  scheduledAt DateTime
  reason      String          // Motif de la visite
  notes       String?         // Instructions spéciales
  photoUrl    String?         // Photo preuve (Cloudinary)
  reportUrl   String?         // Rapport PDF (Cloudinary)
  reportText  String?         // Rapport texte de l'agent
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  patient User  @relation("PatientHomeVisits", fields: [patientId], references: [id])
  agent   User? @relation("AgentHomeVisits", fields: [agentId], references: [id])
  payment Payment?

  @@index([patientId])
  @@index([agentId])
  @@index([status])
}

// ─────────────────────────────────────────────────
// MODEL : Paiement
// ─────────────────────────────────────────────────
model Payment {
  id            String        @id @default(cuid())
  userId        String
  appointmentId String?       @unique
  homeVisitId   String?       @unique
  labExamId     String?       @unique
  nursingCareId String?       @unique
  elderlyCareId String?       @unique
  amount        Float
  currency      String        @default("XAF")
  method        String        // MTN_MONEY | AIRTEL_MONEY | CARD
  status        PaymentStatus @default(PENDING)
  flwRef        String?       // Référence transaction Flutterwave
  flwTxId       String?       // ID transaction Flutterwave
  receiptUrl    String?       // URL reçu PDF Cloudinary
  refundedAt    DateTime?
  refundReason  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  commandePharmacieId String?       @unique

  user              User              @relation(fields: [userId], references: [id])
  appointment       Appointment?      @relation(fields: [appointmentId], references: [id])
  homeVisit         HomeVisit?        @relation(fields: [homeVisitId], references: [id])
  labExam           LabExam?          @relation(fields: [labExamId], references: [id])
  nursingCare       NursingCare?      @relation(fields: [nursingCareId], references: [id])
  elderlyCare       ElderlyCare?      @relation(fields: [elderlyCareId], references: [id])
  commandePharmacie CommandePharmacie? @relation(fields: [commandePharmacieId], references: [id])
  presentiel        RendezVousPresentiel? @relation(fields: [presentielId], references: [id])
  presentielId      String?           @unique

  @@index([userId])
  @@index([status])
}

// ─────────────────────────────────────────────────
// MODEL : Notification
// ─────────────────────────────────────────────────
model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String   // APPOINTMENT_CONFIRMED | PAYMENT_SUCCESS | etc.
  title       String
  message     String
  isRead      Boolean  @default(false)
  sentBySMS   Boolean  @default(false)
  sentByEmail Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
}

// ─────────────────────────────────────────────────
// MODEL : Journal d'audit (CRITIQUE — ne jamais supprimer)
// ─────────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String   // Ex: ACCESSED_PATIENT_RECORD
  targetId   String?  // ID de la ressource ciblée
  targetType String?  // Ex: Appointment | PatientProfile
  details    Json?    // Infos supplémentaires
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────
// MODEL : Chat interne (Call Center ↔ Admin uniquement)
// ─────────────────────────────────────────────────
model ChatMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
}

// ─────────────────────────────────────────────────
// ENUMS V2
// ─────────────────────────────────────────────────

