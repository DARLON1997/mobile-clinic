generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url gérée via prisma.config.ts (Prisma 7 — pas de url ici)
}

// ─────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  CALL_CENTER_AGENT
  MEDECIN
  AGENT_TERRAIN
  PATIENT
}

enum AppointmentStatus {
  PENDING            // En attente validation Call Center
  AWAITING_APPROVAL  // Soumis à l'Admin, en attente
  APPROVED           // Approuvé par l'Admin
  REJECTED           // Refusé par l'Admin
  PAYMENT_PENDING    // En attente de paiement
  CONFIRMED          // Payé et confirmé
  IN_PROGRESS        // Consultation en cours
  COMPLETED          // Consultation terminée
  CANCELLED          // Annulé
  NO_SHOW            // Patient absent
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum HomeVisitType {
  CARE      // Soin à domicile
  SAMPLING  // Prélèvement à domicile
}

enum HomeVisitStatus {
  PENDING   // En attente d'assignation
  ASSIGNED  // Agent assigné
  EN_ROUTE  // Agent en route
  ARRIVED   // Agent arrivé
  COMPLETED // Mission terminée
  CANCELLED // Mission annulée
}

enum MedicalSpeciality {
  GENERALISTE
  CARDIOLOGUE
  DERMATOLOGUE
  PEDIATRE
  GYNECOLOGUE
  OPHTALMOLOGUE
  PSYCHIATRE
  NEUROLOGUE
  ORTHOPEDIE
  AUTRE
}

// ─────────────────────────────────────────────────
// MODEL : Compte utilisateur (tous rôles confondus)
// ─────────────────────────────────────────────────
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String    @unique
  passwordHash String
  role         Role
  isActive     Boolean   @default(true)
  isVerified   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  // Profils (un seul actif selon le rôle)
  patientProfile PatientProfile?
  doctorProfile  DoctorProfile?
  agentProfile   AgentProfile?

  // Rendez-vous selon le rôle
  appointmentsAsPatient    Appointment[] @relation("PatientAppointments")
  appointmentsAsDoctor     Appointment[] @relation("DoctorAppointments")
  appointmentsAsCallCenter Appointment[] @relation("CallCenterAppointments")

  // Visites à domicile selon le rôle
  homeVisitsAsPatient HomeVisit[] @relation("PatientHomeVisits")
  homeVisitsAsAgent   HomeVisit[] @relation("AgentHomeVisits")

  // Messagerie interne
  sentMessages     ChatMessage[] @relation("SentMessages")
  receivedMessages ChatMessage[] @relation("ReceivedMessages")

  // Autres
  notifications Notification[]
  auditLogs     AuditLog[]
  payments      Payment[]

  // Examens de laboratoire
  labExamsAsPatient  LabExam[] @relation("PatientLabExams")
  labExamsAsAgent    LabExam[] @relation("AgentLabExams")
  requestedLabExams  LabExam[] @relation("RequestedLabExams")

  // Soins infirmiers
  nursingCaresAsPatient NursingCare[] @relation("PatientNursingCares")
  nursingCaresAsAgent   NursingCare[] @relation("AgentNursingCares")

  // Soins personnes âgées
  elderlyCaresAsPatient ElderlyCare[] @relation("PatientElderlyCares")
  elderlyCaresAsAgent   ElderlyCare[] @relation("AgentElderlyCares")

  // Chat support patient ↔ Call Center
  patientChats    SupportChat[]    @relation("PatientChats")
  callCenterChats SupportChat[]    @relation("CallCenterChats")
  supportMessages SupportMessage[] @relation("SupportMessageSender")

  @@index([email])
  @@index([phone])
  @@index([role])
}

// ─────────────────────────────────────────────────
// MODEL : Profil Patient
// ─────────────────────────────────────────────────
model PatientProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  firstName        String
  lastName         String
  dateOfBirth      DateTime
  gender           String
  bloodType        String?
  address          String
  city             String
  medicalHistory   String?  // Antécédents médicaux
  allergies        String?  // Allergies connues
  emergencyContact String?  // Nom + téléphone contact urgence
  avatarUrl        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────
// MODEL : Profil Médecin
// ─────────────────────────────────────────────────
model DoctorProfile {
  id                String            @id @default(cuid())
  userId            String            @unique
  firstName         String
  lastName          String
  speciality        MedicalSpeciality
  licenseNumber     String            @unique
  isVerifiedByAdmin Boolean           @default(false)
  consultationFee   Float
  bio               String?
  avatarUrl         String?
  availabilities    Json?             // Créneaux JSON
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────
// MODEL : Profil Agent Terrain
// ─────────────────────────────────────────────────
model AgentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String
  lastName  String
  zone      String   // Zone géographique couverte
  phone     String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────
// MODEL : Rendez-vous
// ─────────────────────────────────────────────────
model Appointment {
  id              String            @id @default(cuid())
  patientId       String
  doctorId        String
  callCenterId    String?
  scheduledAt     DateTime
  duration        Int               @default(30) // minutes
  status          AppointmentStatus @default(PENDING)
  // RÈGLE DB-1 : adminApprovedAt IS NOT NULL = autorisé par l'Admin
  // NULL signifie que le médecin ne peut PAS accéder au dossier patient
  adminApprovedAt DateTime?
  adminApprovedBy String?           // ID de l'admin qui a approuvé
  adminNote       String?           // Note de refus ou d'approbation
  videoRoomUrl    String?           // URL salle Daily.co
  videoRoomName   String?           // Nom salle Daily.co
  reason          String            // Motif de consultation
  notes           String?           // Notes internes Call Center
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  patient      User          @relation("PatientAppointments", fields: [patientId], references: [id])
  doctor       User          @relation("DoctorAppointments", fields: [doctorId], references: [id])
  callCenter   User?         @relation("CallCenterAppointments", fields: [callCenterId], references: [id])
  payment      Payment?
  consultation Consultation?

  @@index([patientId])
  @@index([doctorId])
  @@index([scheduledAt])
  @@index([status])
}

// ─────────────────────────────────────────────────
// MODEL : Consultation (créée après le RDV terminé)
// ─────────────────────────────────────────────────
model Consultation {
  id              String    @id @default(cuid())
  appointmentId   String    @unique
  clinicalNotes   String?   // Notes médicales du médecin
  diagnosis       String?   // Diagnostic posé
  prescriptionUrl String?   // URL PDF ordonnance sur Cloudinary
  followUpDate    DateTime? // Date de suivi recommandée
  duration        Int?      // Durée réelle de la consultation (min)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id])
}

// ─────────────────────────────────────────────────
// MODEL : Visite à domicile
// ─────────────────────────────────────────────────
model HomeVisit {
  id          String          @id @default(cuid())
  patientId   String
  agentId     String?         // Assigné par l'Admin
  type        HomeVisitType
  status      HomeVisitStatus @default(PENDING)
  address     String
  city        String
  scheduledAt DateTime
  reason      String          // Motif de la visite
  notes       String?         // Instructions spéciales
  photoUrl    String?         // Photo preuve (Cloudinary)
  reportUrl   String?         // Rapport PDF (Cloudinary)
  reportText  String?         // Rapport texte de l'agent
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  patient User  @relation("PatientHomeVisits", fields: [patientId], references: [id])
  agent   User? @relation("AgentHomeVisits", fields: [agentId], references: [id])
  payment Payment?

  @@index([patientId])
  @@index([agentId])
  @@index([status])
}

// ─────────────────────────────────────────────────
// MODEL : Paiement
// ─────────────────────────────────────────────────
model Payment {
  id            String        @id @default(cuid())
  userId        String
  appointmentId String?       @unique
  homeVisitId   String?       @unique
  labExamId     String?       @unique
  nursingCareId String?       @unique
  elderlyCareId String?       @unique
  amount        Float
  currency      String        @default("XAF")
  method        String        // MTN_MONEY | AIRTEL_MONEY | CARD
  status        PaymentStatus @default(PENDING)
  flwRef        String?       // Référence transaction Flutterwave
  flwTxId       String?       // ID transaction Flutterwave
  receiptUrl    String?       // URL reçu PDF Cloudinary
  refundedAt    DateTime?
  refundReason  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  homeVisit   HomeVisit?   @relation(fields: [homeVisitId], references: [id])
  labExam     LabExam?     @relation(fields: [labExamId], references: [id])
  nursingCare NursingCare? @relation(fields: [nursingCareId], references: [id])
  elderlyCare ElderlyCare? @relation(fields: [elderlyCareId], references: [id])

  @@index([userId])
  @@index([status])
}

// ─────────────────────────────────────────────────
// MODEL : Notification
// ─────────────────────────────────────────────────
model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String   // APPOINTMENT_CONFIRMED | PAYMENT_SUCCESS | etc.
  title       String
  message     String
  isRead      Boolean  @default(false)
  sentBySMS   Boolean  @default(false)
  sentByEmail Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
}

// ─────────────────────────────────────────────────
// MODEL : Journal d'audit (CRITIQUE — ne jamais supprimer)
// ─────────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String   // Ex: ACCESSED_PATIENT_RECORD
  targetId   String?  // ID de la ressource ciblée
  targetType String?  // Ex: Appointment | PatientProfile
  details    Json?    // Infos supplémentaires
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────
// MODEL : Chat interne (Call Center ↔ Admin uniquement)
// ─────────────────────────────────────────────────
model ChatMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
}

// ─────────────────────────────────────────────────
// ENUMS V2
// ─────────────────────────────────────────────────

enum LabExamStatus {
  PENDING
  ASSIGNED
  SAMPLE_COLLECTED
  IN_ANALYSIS
  RESULTS_READY
  DELIVERED
  CANCELLED
}

enum LabExamType {
  BILAN_SANGUIN
  GLYCEMIE
  BILAN_LIPIDIQUE
  BILAN_HEPATIQUE
  BILAN_RENAL
  BILAN_THYROIDIEN
  EXAMEN_URINE
  EXAMEN_SELLES
  TEST_PALUDISME
  TEST_VIH
  TEST_GROSSESSE
  BILAN_COMPLET
  AUTRE
}

enum NursingCareType {
  PRISE_TENSION
  INJECTION
  PANSEMENT
  PERFUSION
  PRISE_DE_SANG
  SUIVI_POST_OPERATOIRE
  ADMINISTRATION_MED
  SOINS_PLAIE
  AUTRE_SOIN
}

enum NursingCareStatus {
  PENDING
  ASSIGNED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ElderlyCareType {
  SUIVI_MEDICAL
  AIDE_MOBILITE
  GESTION_MEDICAMENTS
  SOINS_HYGIENE
  COMPAGNIE_MEDICALISEE
  REEDUCATION
  BILAN_SANTE
  AUTRE_ELDERLY
}

enum ElderlyCareFrequency {
  PONCTUEL
  QUOTIDIEN
  HEBDOMADAIRE
  MENSUEL
}

enum ElderlyCareStatus {
  PENDING
  ASSIGNED
  ACTIVE
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────────
// MODEL : Examen de laboratoire
// ─────────────────────────────────────────────────
model LabExam {
  id              String        @id @default(cuid())
  patientId       String
  agentId         String?
  requestedById   String
  examTypes       LabExamType[]
  status          LabExamStatus @default(PENDING)
  address         String
  city            String
  scheduledAt     DateTime
  collectedAt     DateTime?
  resultsAt       DateTime?
  instructions    String?
  agentNotes      String?
  samplePhotoUrl  String?
  resultFileUrl   String?
  resultNotes     String?
  prescriptionRef String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  patient     User     @relation("PatientLabExams",   fields: [patientId],     references: [id])
  agent       User?    @relation("AgentLabExams",     fields: [agentId],       references: [id])
  requestedBy User     @relation("RequestedLabExams", fields: [requestedById], references: [id])
  payment     Payment?

  @@index([patientId])
  @@index([agentId])
  @@index([status])
}

// ─────────────────────────────────────────────────
// MODEL : Soin infirmier
// ─────────────────────────────────────────────────
model NursingCare {
  id              String            @id @default(cuid())
  patientId       String
  agentId         String?
  careTypes       NursingCareType[]
  status          NursingCareStatus @default(PENDING)
  address         String
  city            String
  scheduledAt     DateTime
  completedAt     DateTime?
  duration        Int?
  instructions    String?
  materials       String?
  agentNotes      String?
  reportUrl       String?
  photoUrl        String?
  prescriptionRef String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  patient User  @relation("PatientNursingCares", fields: [patientId], references: [id])
  agent   User? @relation("AgentNursingCares",   fields: [agentId],   references: [id])
  payment Payment?

  @@index([patientId])
  @@index([agentId])
  @@index([status])
}

// ─────────────────────────────────────────────────
// MODEL : Soin personnes âgées
// ─────────────────────────────────────────────────
model ElderlyCare {
  id            String               @id @default(cuid())
  patientId     String
  agentId       String?
  careTypes     ElderlyCareType[]
  frequency     ElderlyCareFrequency @default(PONCTUEL)
  status        ElderlyCareStatus    @default(PENDING)
  address       String
  city          String
  scheduledAt   DateTime
  endDate       DateTime?
  completedAt   DateTime?
  duration      Int                  @default(60)
  patientAge    Int?
  medicalNotes  String?
  mobilityLevel String?
  agentNotes    String?
  reportUrl     String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  patient User  @relation("PatientElderlyCares", fields: [patientId], references: [id])
  agent   User? @relation("AgentElderlyCares",   fields: [agentId],   references: [id])
  payment Payment?

  @@index([patientId])
  @@index([agentId])
  @@index([status])
}

// ─────────────────────────────────────────────────
// MODEL : Chat Support patient ↔ Call Center
// ─────────────────────────────────────────────────
model SupportChat {
  id            String   @id @default(cuid())
  patientId     String
  callCenterId  String?
  subject       String
  isOpen        Boolean  @default(true)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient    User  @relation("PatientChats",    fields: [patientId],    references: [id])
  callCenter User? @relation("CallCenterChats", fields: [callCenterId], references: [id])
  messages   SupportMessage[]

  @@index([patientId])
  @@index([callCenterId])
  @@index([isOpen])
}

model SupportMessage {
  id        String   @id @default(cuid())
  chatId    String
  senderId  String
  content   String
  isRead    Boolean  @default(false)
  fileUrl   String?
  createdAt DateTime @default(now())

  chat   SupportChat @relation(fields: [chatId],   references: [id], onDelete: Cascade)
  sender User        @relation("SupportMessageSender", fields: [senderId], references: [id])

  @@index([chatId])
  @@index([senderId])
  @@index([isRead])
}
